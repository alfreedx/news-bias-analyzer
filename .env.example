# Copia este archivo como .env y ajusta lo que necesites. Ningún valor es secreto.

# Dominios desde los que se servirá la web (separados por comas). Imprescindible en producción.
ALLOWED_HOSTS=localhost,127.0.0.1

# Pon true cuando sirvas la web por HTTPS (activa HSTS y upgrade-insecure-requests).
HTTPS_ONLY=false

# Pon true SOLO si hay un proxy inverso de confianza delante que fije X-Forwarded-For.
TRUST_PROXY_HEADERS=false

# Búsquedas por minuto y cliente.
RATE_LIMIT_PER_MINUTE=30
SUGGEST_RATE_LIMIT_PER_MINUTE=120

# Ingesta de RSS
INGEST_ENABLED=true
INGEST_INTERVAL_MINUTES=10
# Simultaneous feed requests (at most 2 to the same host)
INGEST_CONCURRENCY=8
RETENTION_DAYS=120
# Paginas de verificadores (ClaimReview) leidas por ciclo de ingesta (0 = desactivado) y dias que se guardan
CLAIMS_PER_CYCLE=20
CLAIMS_RETENTION_DAYS=730
DATA_DIR=./var

# Proveedor opcional de búsqueda en vivo. Las condiciones del RSS de Google News solo
# permiten uso personal y no comercial: no lo actives en una instancia pública.
GOOGLE_NEWS_ENABLED=false

# Instantánea cifrada del índice (release `data-snapshot` del repositorio). Solo se restaura al arrancar
# si SNAPSHOT_KEY está definida y el índice local tiene menos de SNAPSHOT_MIN_ARTICLES titulares.
# La clave es secreta: no la subas al repositorio. Genera una con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# SNAPSHOT_URL se deriva de REPO_URL; solo hace falta si usas otra ubicación (https, hosts de GitHub).
SNAPSHOT_KEY=
SNAPSHOT_MIN_ARTICLES=2000

# Enlaces que aparecen en la web
SITE_URL=http://localhost:8000
REPO_URL=https://github.com/alfreedx/news-bias-analyzer
